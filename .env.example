# Copy to .env for Docker Compose; never commit credentials.
# Set database: /data/watch.db and inventory: /config/systems.yaml in the mounted config.
# The CLI does not load .env automatically. Export variables through your shell or service manager.

# Set only the provider keys you use. ModelSpec.api_key_env can name a different variable.
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# COHERE_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# NVIDIA_API_KEY=
# SAMBANOVA_API_KEY=
# HF_TOKEN=
# PERPLEXITY_API_KEY=

# Local/gateway keys are optional only when allow_private_endpoint is true.
# OLLAMA_API_KEY=
# LM_STUDIO_API_KEY=
# VLLM_API_KEY=
# LITELLM_API_KEY=

# Models have no defaults: use IDs available to your account or local server.
# ANALYSIS_MODEL=
# VERIFICATION_MODEL=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_ENDPOINT=
# LOCAL_MODEL=

# Live smoke test from a source checkout: npm run build, then
# node scripts/check-models.mjs --live --providers openai
# Also set SECURITY_WATCH_SMOKE_<PROVIDER>_MODEL for each chosen provider.
# Use uppercase provider IDs, replacing hyphens with underscores (AZURE_OPENAI, OPENAI_COMPATIBLE).
# Optional suffixes: _ENDPOINT, _OUTPUT_FORMAT, _ALLOW_PRIVATE=1.
# SECURITY_WATCH_SMOKE_OPENAI_MODEL=
# SECURITY_WATCH_SMOKE_AZURE_OPENAI_MODEL=
# SECURITY_WATCH_SMOKE_AZURE_OPENAI_ENDPOINT=
# SECURITY_WATCH_SMOKE_OLLAMA_MODEL=
# SECURITY_WATCH_SMOKE_OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# SECURITY_WATCH_SMOKE_OLLAMA_ALLOW_PRIVATE=1
# Without --live the script makes no requests. Missing keys/models are reported as skipped.

# GITHUB_TOKEN=
# SLACK_WEBHOOK_URL=
# SMTP_URL=
# HEARTBEAT_URL=
# Use a private ping URL from an independent outage monitor. No inventory or logs are sent.
# Configure monitoring.heartbeat_url_env: HEARTBEAT_URL before starting the worker.
# Docker Compose: export SECURITY_WATCH_UID=$(id -u) SECURITY_WATCH_GID=$(id -g)
# or put those numeric IDs here so private host-owned files remain accessible.
