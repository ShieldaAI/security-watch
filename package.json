{
  "name": "@shieldaai/security-watch",
  "version": "1.2.0",
  "description": "Self-hosted security alerts for the software you run: reads your lockfiles (npm, Python, Go, Rust, Java and 7 more ecosystems) or any SBOM, watches new advisories and security news, and alerts you on Slack or email.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10.0"
  },
  "bin": {
    "security-watch": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=88 --test-coverage-functions=95 --test-coverage-exclude=test/** test/*.test.mjs",
    "check": "npm run format:check && npm test && node scripts/check-package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:models": "npm run build && node scripts/check-models.mjs",
    "evaluate:models": "npm run build && node scripts/evaluate-models.mjs",
    "start": "node dist/cli.js start",
    "prepublishOnly": "node scripts/release-check.mjs",
    "release": "node scripts/release.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "check:docker": "node scripts/check-docker.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "evaluate:outcomes": "npm run build && node scripts/evaluate-alerts.mjs"
  },
  "dependencies": {
    "@renovatebot/pep440": "6.0.0",
    "fast-xml-parser": "5.12.1",
    "ipaddr.js": "2.5.0",
    "nodemailer": "10.2.1",
    "parse5": "8.0.1",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/semver": "7.7.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldaAI/security-watch.git"
  },
  "bugs": {
    "url": "https://github.com/ShieldaAI/security-watch/issues"
  },
  "homepage": "https://github.com/ShieldaAI/security-watch#readme",
  "keywords": [
    "security",
    "vulnerability-monitoring",
    "security-advisories",
    "cve",
    "sbom",
    "cyclonedx",
    "spdx",
    "lockfile",
    "dependency-monitoring",
    "supply-chain-security",
    "github-action",
    "slack",
    "email-alerts",
    "self-hosted"
  ]
}
