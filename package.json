{
  "name": "@shieldaai/security-watch",
  "version": "0.1.0-alpha.0",
  "description": "Evidence-led security advisory and news monitoring for your systems",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "security-watch": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run format:check && npm test && node scripts/check-package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:models": "npm run build && node scripts/check-models.mjs",
    "evaluate:models": "npm run build && node scripts/evaluate-models.mjs",
    "start": "node dist/cli.js start",
    "prepublishOnly": "node scripts/release-check.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "check:docker": "node scripts/check-docker.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "ipaddr.js": "2.5.0",
    "nodemailer": "10.2.1",
    "parse5": "8.0.1",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/semver": "7.7.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldaAI/security-watch.git"
  },
  "bugs": {
    "url": "https://github.com/ShieldaAI/security-watch/issues"
  },
  "homepage": "https://github.com/ShieldaAI/security-watch#readme"
}
