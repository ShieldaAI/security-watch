{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "declaration": true, "types": ["node"],
    "outDir": "dist", "rootDir": "src", "skipLibCheck": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
